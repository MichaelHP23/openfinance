DATABASE_URL=postgresql+psycopg://openfinance:openfinance@localhost:5432/openfinance
REDIS_URL=redis://localhost:6379/0
# Required. Boot fails on the published default — it derives the encryption key for
# provider credentials. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Single-user desktop mode: no login, one household. NEVER enable on a reachable host.
LOCAL_MODE=true

# Background sync + daily balance snapshot cadence, in hours. 0 disables the loop.
SYNC_INTERVAL_HOURS=6

# AI assistant (optional). Without a key the assistant is hidden and nothing is ever
# sent anywhere. With one, a computed summary of your finances goes to Anthropic.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
